# Text files are stored with LF line endings; Git converts them as configured on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree
*.ps1 text eol=crlf
*.iss text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# binary
*.png binary
*.ico binary
*.ttf binary
*.onnx binary
*.dll binary
*.exe binary
*.ass text eol=lf
